<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthSystemApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HealthSystemApp"
    Title="HealthSystemApp">

    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />

    <ShellContent
    Title="Patients" 
    ContentTemplate="{DataTemplate local:PatientsPage}"
    Route="PatientsPage" />

    <ShellContent
    Title="Physicians"
    ContentTemplate="{DataTemplate local:PhysiciansPage}"
    Route="PhysiciansPage" />
    <ShellContent
    Title="Appointments"
    ContentTemplate="{DataTemplate local:AppointmentsPage}"
    Route="AppointmentsPage" />

</Shell>
